# Fluxer bot credentials for Wordle Bot
# Copy this file to .env and fill in real values. Never commit .env.
FLUXER_BOT_TOKEN=your-bot-token-here
FLUXER_APPLICATION_ID=your-application-id-here
FLUXER_API_URL=https://api.canary.fluxer.app
PUZZLES_CHANNEL_ID=your-puzzles-channel-id-here

# Optional: IANA timezone used to compute "today" for the shared daily word.
# Defaults to America/New_York if unset.
ANSWER_TIMEZONE=America/New_York

# Optional: port for the health-check HTTP endpoint (used by Docker healthcheck).
# Leave unset to disable the health server.
HEALTH_PORT=8091
